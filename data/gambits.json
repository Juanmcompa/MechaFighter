          "tipo": "entero",
          "min": 1,
          "max": 8,
          "defecto": 2
        }
      },
      "expr": {
        "existe": "enemigo",
        "donde": {
          "dato": "distancia",
          "op": "<=",
          "param": "casillas"
        }
      }
